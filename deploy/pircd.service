[Unit]
Description=pircd - remote control for the pi coding agent

[Service]
Type=simple
# PATH (pi is a node script) and PIRCD_ARGS live here; written by deploy/install.sh
EnvironmentFile=-%h/.config/pircd/env
# tailscaled may still be starting at boot: wait for it, and if it never
# shows up exit non-zero so systemd retries rather than serving loopback only
ExecStart=%h/.local/bin/pircd -wait-tailscale 2m $PIRCD_ARGS
Restart=on-failure
RestartSec=10
# SIGTERM pircd only, so it can shut its pi processes down cleanly
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
